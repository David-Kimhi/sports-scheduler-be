# ---- backend Dockerfile (single-stage) ----
FROM node:20-alpine

# If you actually need rsync on the backend, install it like this (apk, not apt)
# Most backends don't need rsync, so you can remove this line if not used.
RUN apk add --no-cache rsync

WORKDIR /app

# Install dependencies based on lockfile
COPY package*.json ./
# Use npm ci for reproducibility; we need dev deps to compile TypeScript
RUN npm ci

# Copy source and build
COPY . .
RUN npm run build

RUN npm install dotenv
# At runtime we only need production deps; prune dev to slim the image
RUN npm ci --omit=dev

# Make sure dotenv is declared in package.json "dependencies" (not installed ad-hoc)
# Remove the "RUN npm install dotenv" line from your original Dockerfile.

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Ensure your server listens on 0.0.0.0
CMD ["npm", "run", "start:server"]
    